# Copy this to .env and fill in the values for your environment.

# --- Local dev (without Docker) ---
# SAGE_BIN=/home/crc-user/miniconda3/envs/sage-env/bin/sage
# ESTIMATOR_PATH=/home/crc-user/Downloads/master-degree/my-master/implementations/Cryptanlaysis/lattice-estimator

# --- Docker (paths are baked into the image) ---
SAGE_BIN=/usr/bin/sage
ESTIMATOR_PATH=/opt/lattice-estimator

# Comma-separated list of allowed frontend origins (CORS)
# Local dev:
# ALLOWED_ORIGINS=http://localhost:5173
# Production:
ALLOWED_ORIGINS=https://your-domain.com

# Timeout for each estimation run in seconds
ESTIMATOR_TIMEOUT=120
